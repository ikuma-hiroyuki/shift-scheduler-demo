DATABASE_URL=postgresql+asyncpg://demomart:demomart@db:5432/demomart
SECRET_KEY=changeme-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
SEED_ADMIN_PASSWORD=your-secure-password
# Google reCAPTCHA v2 invisible (ログイン画面用) シークレットキー。
# 空のままにするとログイン時の reCAPTCHA 検証を完全にスキップする (開発バイパス)。
# 本番環境では必ず設定する。
RECAPTCHA_SECRET=

# ------------------------------------------------------------------ #
# Production-only (Render env)
# ------------------------------------------------------------------ #
# bootstrap_admin スクリプトが本番 DB に upsert する管理者ユーザー。
# Render の Pre-Deploy Command:
#   alembic upgrade head && python -m app.scripts.bootstrap_admin
# 開発・テストでは未設定でよい (seed.py が SEED_ADMIN_PASSWORD を使う)。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS_ALLOWED_ORIGINS は Cloudflare Pages の rewrites 経由 (同一 origin) 運用のため
# 設定不要。frontend を別 origin にホストする場合のみ必要 (未実装)。
