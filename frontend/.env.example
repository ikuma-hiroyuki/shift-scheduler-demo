# Google reCAPTCHA v2 invisible のサイトキー (公開してよい値)。
# 空のままにすると LoginPage は widget を描画しない (開発バイパス)。
# 本番では https://www.google.com/recaptcha/admin で reCAPTCHA v2 (invisible) 用に
# 取得したサイトキーを設定する。
VITE_RECAPTCHA_SITE_KEY=

# バックエンド (Render) の絶対URL。Cloudflare Pages は外部オリジンへの
# プロキシに非対応のため必須。ローカル開発では未設定のままでよい
# (Vite dev server のプロキシ経由で相対パスを使う)。
VITE_API_URL=
